// CCC POS — Canadian Cellular Communication

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/* ------------------------------ stores ------------------------------ */

/// One shop. Every record below belongs to exactly one, and nothing crosses
/// between them unless the store has explicitly shared it (see StoreShare).
model Store {
  id   String @id @default(cuid())
  name String

  // Branding. Each is a data: URL, so there's no file store to run.
  // See LOGO_SLOTS in routes/stores.js for where each one is shown.
  logoLight String? @db.LongText // full logo, light background
  logoDark  String? @db.LongText // full logo, dark background
  iconLight String? @db.LongText // square mark, collapsed sidebar, light
  iconDark  String? @db.LongText // square mark, collapsed sidebar, dark
  authLogo  String? @db.LongText // sign-in screen

  address String? @db.Text
  phone   String?
  website String?

  /// Printed at the bottom of service intake and collection paperwork.
  serviceTerms String? @db.Text

  // Label stock this store prints on.
  labelWidthMm  Int @default(50)
  labelHeightMm Int @default(25)

  // Clover connection, filled in from Store settings -> Connect to Clover.
  // Per store, so two shops on one deployment keep separate merchant accounts.
  // These credentials read and write the merchant's own data through the REST
  // API; nothing here touches a payment terminal.
  cloverEnv        String  @default("production") // production | sandbox
  cloverMerchantId String? @unique // the account these credentials belong to
  cloverApiToken   String? @db.Text // secret — masked before it ever reaches the browser
  cloverVerifiedAt DateTime? // last time the credentials answered Clover
  cloverPolledAt   DateTime? // how far the order poller has read; see clover-poll.js

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  users      User[]
  locations  Location[]
  categories Category[]
  vendors    Vendor[]
  brands     Brand[]
  products   Product[]
  units      ProductUnit[]
  customers  Customer[]
  tickets    Ticket[]
  sales      Sale[]
  layaways   Layaway[]
  invoices   Invoice[]
  performance PerformanceEntry[]

  sharesGranted  StoreShare[] @relation("SharingStore")
  sharesReceived StoreShare[] @relation("ViewingStore")
}

/// A one-way, read-only window from one store into another's records.
///
/// The store that owns the data creates the row: they look the other shop up by
/// a staff email, then tick exactly which fields to hand over. Nothing is
/// visible that isn't ticked, and the grant can be withdrawn at any time.
model StoreShare {
  id String @id @default(cuid())

  /// Whose data is being shared.
  ownerStoreId String
  ownerStore   Store  @relation("SharingStore", fields: [ownerStoreId], references: [id], onDelete: Cascade)

  /// Who gets to look at it.
  viewerStoreId String
  viewerStore   Store  @relation("ViewingStore", fields: [viewerStoreId], references: [id], onDelete: Cascade)

  /// Field-by-field grants — see PERMISSIONS in routes/sharing.js for the shape.
  /// Anything missing counts as "not shared".
  permissions Json

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([ownerStoreId, viewerStoreId])
  @@index([viewerStoreId])
}

/* ------------------------------ staff ------------------------------ */

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("STAFF") // OWNER | MANAGER | STAFF | TECH
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  pinHash String?

  /// The master account: runs the whole system and belongs to no store.
  /// Sees every store read-only and creates their staff, but owns no data.
  superAdmin Boolean @default(false)

  /// Null only for the master — everyone else works inside exactly one store.
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  sales           Sale[]
  ticketsAssigned Ticket[] @relation("Technician")

  @@index([storeId])
  performance PerformanceEntry[]
}

model Location {
  id      String  @id @default(cuid())
  name    String
  address String? @db.Text
  active  Boolean @default(true)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  units ProductUnit[]
  sales    Sale[]
  tickets  Ticket[]

  @@unique([storeId, name])
  @@index([storeId])
}

/* ---------------------------- inventory ---------------------------- */

model Category {
  id   String @id @default(cuid())
  name String

  // One level only: a category with a parent can't have children of its own.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  products Product[]

  @@index([parentId])
  @@index([storeId])
}

model Vendor {
  id   String @id @default(cuid())
  name String

  accountNumber String? // your account number with them
  contactPerson String?
  currency      String  @default("CAD") // CAD | USD

  phone  String?
  mobile String?
  fax    String?

  email1 String?
  email2 String?

  country  String? @default("CA")
  address  String? @db.Text
  address2 String? @db.Text
  city     String?
  province String?
  postal   String?

  notes String? @db.Text

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  products Product[]
  stockEntries StockEntry[]
  units ProductUnit[]

  @@unique([storeId, name])
  @@index([storeId])
}

model Brand {
  id   String @id @default(cuid())
  name String

  notes  String? @db.Text
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  products Product[]

  @@unique([storeId, name])
  @@index([storeId])
}

model Product {
  id   String @id @default(cuid())
  name String

  sku       String
  upc       String?
  ean       String?
  customSku String?

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  costCents        Int @default(0) // what you paid
  onlinePriceCents Int @default(0) // listed online
  salePriceCents   Int @default(0) // what you sell for in store

  taxable      Boolean @default(true)
  reorderAt    Int     @default(0)
  notes        String? @db.Text
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  units        ProductUnit[]
  stockEntries StockEntry[]
  saleItems    SaleItem[]
  layawayItems LayawayItem[]
  ticketParts  TicketPart[]

  @@unique([storeId, sku])
  @@index([name])
  @@index([upc])
  @@index([storeId])

  tracksSerials Boolean @default(true)
}

/// One physical device — its own serial, condition, and shelf.
model ProductUnit {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  serial    String
  condition String // NEW | OPEN_BOX | USED_LIKE_NEW | USED_GOOD | USED_FAIR | FOR_PARTS
  storage   String?
  color     String?
  warrantyMonths Int @default(3)
  salePriceCents Int? // what this one unit sells for; null falls back to the product's price
  labelCostCents Int? // price shown on the printed tag; not used in accounting
  note String? @db.Text
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  status String @default("IN_STOCK") // IN_STOCK | RESERVED | SOLD | RETURNED

  /// The item this serial has in the connected Clover account, set when the
  /// serial is first pushed. Null means it was never pushed — either the store
  /// isn't connected to Clover, or the push failed and can be retried.
  cloverItemId String?

  /// The sale this serial went out on. Set when a sale rung up on the Clover
  /// register is matched back to this unit, so the serial row can point at it.
  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, serial])
  @@index([productId])
  @@index([status])
  @@index([storeId])
}

/// A batch of stock coming in — the quantity on hand is the sum of these.
/// Sales and write-offs go in as negative quantities.
model StockEntry {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity  Int // negative for corrections and sales
  costCents Int @default(0) // what this batch cost per unit

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  note String? @db.Text

  createdAt DateTime @default(now())

  @@index([productId])
}

/* ---------------------------- customers ---------------------------- */

model Customer {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  phone     String?
  email     String?
  address   String? @db.Text
  city      String?
  postal    String?
  notes     String? @db.Text
  createdAt DateTime @default(now())

  company        String?
  mobile         String?
  contactConsent Boolean @default(false)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  sales    Sale[]
  tickets  Ticket[]
  layaways Layaway[]

  @@index([phone])
  @@index([lastName])
  @@index([storeId])
}

/* -------------------------- service tickets -------------------------- */

model Ticket {
  id     String @id @default(cuid())
  number Int // assigned in code (max + 1 within the store)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  deviceMake  String?
  deviceModel String?
  deviceImei  String?
  passcode    String?
  issue       String  @db.Text
  diagnosis   String? @db.Text

  warranty     Boolean   @default(false)
  dateIn       DateTime?
  receiptNote  String?   @db.Text
  externalNote String?   @db.Text
  internalNote String?   @db.Text

  status String @default("INTAKE") // INTAKE | DIAGNOSING | WAITING_PARTS | READY | COLLECTED | CANCELLED

  estimateCents Int @default(0)
  labourCents   Int @default(0)
  depositCents  Int @default(0)

  technicianId String?
  technician   User?     @relation("Technician", fields: [technicianId], references: [id])
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id])

  promisedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  parts TicketPart[]
  sale  Sale?

  trackToken String? @unique

  signatureData String?   @db.Text
  signedAt      DateTime?

  @@unique([storeId, number])
  @@index([storeId])
}

model TicketPart {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  name       String
  quantity   Int      @default(1)
  priceCents Int      @default(0)
}

/* ------------------------------ sales ------------------------------ */

model Sale {
  id     String @id @default(cuid())
  /// The shop's own sale number, assigned in code (max + 1 within the store).
  /// Null for a sale rung up on the Clover register: that sale already has an
  /// identity in cloverOrderId, and minting a second one would both duplicate
  /// it and push the shop's own numbering along for a sale it didn't ring up.
  number Int?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  ticketId   String?   @unique
  ticket     Ticket?   @relation(fields: [ticketId], references: [id])

  subtotalCents Int @default(0)
  taxCents      Int @default(0)
  totalCents    Int @default(0)

  status String @default("OPEN") // OPEN | PAID | REFUNDED | VOID

  source        String  @default("APP") // APP | CLOVER
  cloverOrderId String? @unique
  needsReview   Boolean @default(false)

  createdAt DateTime @default(now())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  items    SaleItem[]
  payments Payment[]
  units    ProductUnit[]
  invoice  Invoice?

  @@unique([storeId, number])
  @@index([storeId])
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  name           String // snapshot — survives later product edits
  quantity       Int    @default(1)
  unitPriceCents Int    @default(0)
  costCents      Int    @default(0) // snapshot, for margin reports
}

model Payment {
  id        String   @id @default(cuid())
  saleId    String?
  sale      Sale?    @relation(fields: [saleId], references: [id])
  layawayId String?
  layaway   Layaway? @relation(fields: [layawayId], references: [id])

  amountCents Int
  method      String // CASH | CARD | ETRANSFER | OTHER
  reference   String? // Clover payment id
  createdAt   DateTime @default(now())
}

/* --------------------------- daily performance --------------------------- */

/// One takings figure as the shop logs it at the end of a day.
///
/// Kept apart from Sale on purpose: this is what the shop counted, entered by
/// hand, and it is allowed to disagree with what the tills recorded. Folding
/// the two together would make each unable to check the other.
model PerformanceEntry {
  id String @id @default(cuid())

  /// The trading day it belongs to, not the moment it was typed in.
  date DateTime @db.Date

  saleType    String // SERVICE | INVENTORY
  paymentType String // CASH | CREDIT_CARD | DEBIT_CARD | CHEQUE | ETRANSFER
  amountCents Int
  note        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, date])
}

/* ----------------------------- layaway ----------------------------- */

model Layaway {
  id     String @id @default(cuid())
  number Int // assigned in code (max + 1 within the store)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  totalCents Int    @default(0)
  paidCents  Int    @default(0)
  status     String @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED | EXPIRED

  expiresAt DateTime?
  notes     String? @db.Text
  createdAt DateTime  @default(now())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  items    LayawayItem[]
  payments Payment[]

  @@unique([storeId, number])
  @@index([storeId])
}

model LayawayItem {
  id             String   @id @default(cuid())
  layawayId      String
  layaway        Layaway  @relation(fields: [layawayId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  name           String
  quantity       Int      @default(1)
  unitPriceCents Int      @default(0)
}

/* ----------------------------- invoices ----------------------------- */

model Invoice {
  id     String @id @default(cuid())
  number Int // assigned in code (max + 1 within the store)
  saleId String @unique
  sale   Sale   @relation(fields: [saleId], references: [id])

  sentTo    String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, number])
  @@index([storeId])
}
