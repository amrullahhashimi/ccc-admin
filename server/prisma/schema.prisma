// CCC POS — Canadian Cellular Communication

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/* ------------------------------ stores ------------------------------ */

/// One shop. Every record below belongs to exactly one, and nothing crosses
/// between them unless the store has explicitly shared it (see StoreShare).
model Store {
  id   String @id @default(cuid())
  name String

  // Branding. Each is a data: URL, so there's no file store to run.
  // See LOGO_SLOTS in routes/stores.js for where each one is shown.
  logoLight String? @db.LongText // full logo, light background
  logoDark  String? @db.LongText // full logo, dark background
  iconLight String? @db.LongText // square mark, collapsed sidebar, light
  iconDark  String? @db.LongText // square mark, collapsed sidebar, dark
  authLogo  String? @db.LongText // sign-in screen

  address String? @db.Text
  phone   String?
  website String?

  /// Printed at the bottom of service intake and collection paperwork.
  serviceTerms String? @db.Text

  // Label stock this store prints on.
  labelWidthMm  Int @default(50)
  labelHeightMm Int @default(25)

  // Clover connection, filled in from Store settings -> Connect to Clover.
  // Per store, so two shops on one deployment keep separate merchant accounts.
  // These credentials read and write the merchant's own data through the REST
  // API; nothing here touches a payment terminal.
  cloverEnv        String  @default("production") // production | sandbox
  cloverMerchantId String? @unique // the account these credentials belong to
  cloverApiToken   String? @db.Text // secret — masked before it ever reaches the browser
  cloverVerifiedAt DateTime? // last time the credentials answered Clover
  cloverPolledAt   DateTime? // how far the order poller has read; see clover-poll.js

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  users      User[]
  locations  Location[]
  categories Category[]
  vendors    Vendor[]
  brands     Brand[]
  products   Product[]
  units      ProductUnit[]
  customers  Customer[]
  tickets    Ticket[]
  sales      Sale[]
  layaways   Layaway[]
  invoices   Invoice[]
  performance PerformanceEntry[]
  catalogProducts CatalogProduct[]
  onlinePrices    OnlinePrice[]
  vendorMessages  VendorMessage[]
  vendorOffers    VendorOffer[]
  offerHistory    OfferPriceHistory[]

  sharesGranted  StoreShare[] @relation("SharingStore")
  sharesReceived StoreShare[] @relation("ViewingStore")
}

/// A one-way, read-only window from one store into another's records.
///
/// The store that owns the data creates the row: they look the other shop up by
/// a staff email, then tick exactly which fields to hand over. Nothing is
/// visible that isn't ticked, and the grant can be withdrawn at any time.
model StoreShare {
  id String @id @default(cuid())

  /// Whose data is being shared.
  ownerStoreId String
  ownerStore   Store  @relation("SharingStore", fields: [ownerStoreId], references: [id], onDelete: Cascade)

  /// Who gets to look at it.
  viewerStoreId String
  viewerStore   Store  @relation("ViewingStore", fields: [viewerStoreId], references: [id], onDelete: Cascade)

  /// Field-by-field grants — see PERMISSIONS in routes/sharing.js for the shape.
  /// Anything missing counts as "not shared".
  permissions Json

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([ownerStoreId, viewerStoreId])
  @@index([viewerStoreId])
}

/* ------------------------------ staff ------------------------------ */

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("STAFF") // OWNER | MANAGER | STAFF | TECH
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  pinHash String?

  /// The master account: runs the whole system and belongs to no store.
  /// Sees every store read-only and creates their staff, but owns no data.
  superAdmin Boolean @default(false)

  /// Null only for the master — everyone else works inside exactly one store.
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  sales           Sale[]
  ticketsAssigned Ticket[] @relation("Technician")
  vendorMessages  VendorMessage[]
  offerChanges    OfferPriceHistory[]

  @@index([storeId])
  performance PerformanceEntry[]
}

model Location {
  id      String  @id @default(cuid())
  name    String
  address String? @db.Text
  active  Boolean @default(true)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  units ProductUnit[]
  sales    Sale[]
  tickets  Ticket[]

  @@unique([storeId, name])
  @@index([storeId])
}

/* ---------------------------- inventory ---------------------------- */

model Category {
  id   String @id @default(cuid())
  name String

  // One level only: a category with a parent can't have children of its own.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  products Product[]

  @@index([parentId])
  @@index([storeId])
}

model Vendor {
  id   String @id @default(cuid())
  name String

  accountNumber String? // your account number with them
  contactPerson String?
  currency      String  @default("CAD") // CAD | USD

  phone  String?
  mobile String?
  fax    String?

  email1 String?
  email2 String?

  country  String? @default("CA")
  address  String? @db.Text
  address2 String? @db.Text
  city     String?
  province String?
  postal   String?

  notes String? @db.Text

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  products Product[]
  stockEntries StockEntry[]
  units ProductUnit[]
  messages VendorMessage[]
  offers   VendorOffer[]

  @@unique([storeId, name])
  @@index([storeId])
}

model Brand {
  id   String @id @default(cuid())
  name String

  notes  String? @db.Text
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  products Product[]

  @@unique([storeId, name])
  @@index([storeId])
}

model Product {
  id   String @id @default(cuid())
  name String

  sku       String
  upc       String?
  ean       String?
  customSku String?

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  costCents        Int @default(0) // what you paid
  onlinePriceCents Int @default(0) // listed online
  salePriceCents   Int @default(0) // what you sell for in store

  taxable      Boolean @default(true)
  reorderAt    Int     @default(0)
  notes        String? @db.Text
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  units        ProductUnit[]
  stockEntries StockEntry[]
  saleItems    SaleItem[]
  layawayItems LayawayItem[]
  ticketParts  TicketPart[]

  @@unique([storeId, sku])
  @@index([name])
  @@index([upc])
  @@index([storeId])

  tracksSerials Boolean @default(true)
}

/// One physical device — its own serial, condition, and shelf.
model ProductUnit {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  serial    String
  condition String // NEW | OPEN_BOX | USED_LIKE_NEW | USED_GOOD | USED_FAIR | FOR_PARTS
  storage   String?
  color     String?
  warrantyMonths Int @default(3)
  salePriceCents Int? // what this one unit sells for; null falls back to the product's price
  labelCostCents Int? // price shown on the printed tag; not used in accounting
  note String? @db.Text
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  status String @default("IN_STOCK") // IN_STOCK | RESERVED | SOLD | RETURNED

  /// The item this serial has in the connected Clover account, set when the
  /// serial is first pushed. Null means it was never pushed — either the store
  /// isn't connected to Clover, or the push failed and can be retried.
  cloverItemId String?

  /// The sale this serial went out on. Set when a sale rung up on the Clover
  /// register is matched back to this unit, so the serial row can point at it.
  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, serial])
  @@index([productId])
  @@index([status])
  @@index([storeId])
}

/// A batch of stock coming in — the quantity on hand is the sum of these.
/// Sales and write-offs go in as negative quantities.
model StockEntry {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity  Int // negative for corrections and sales
  costCents Int @default(0) // what this batch cost per unit

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  note String? @db.Text

  createdAt DateTime @default(now())

  @@index([productId])
}

/* ---------------------------- customers ---------------------------- */

model Customer {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  phone     String?
  email     String?
  address   String? @db.Text
  city      String?
  postal    String?
  notes     String? @db.Text
  createdAt DateTime @default(now())

  company        String?
  mobile         String?
  contactConsent Boolean @default(false)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  sales    Sale[]
  tickets  Ticket[]
  layaways Layaway[]

  @@index([phone])
  @@index([lastName])
  @@index([storeId])
}

/* -------------------------- service tickets -------------------------- */

model Ticket {
  id     String @id @default(cuid())
  number Int // assigned in code (max + 1 within the store)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  deviceMake  String?
  deviceModel String?
  deviceImei  String?
  passcode    String?
  issue       String  @db.Text
  diagnosis   String? @db.Text

  warranty     Boolean   @default(false)
  dateIn       DateTime?
  receiptNote  String?   @db.Text
  externalNote String?   @db.Text
  internalNote String?   @db.Text

  status String @default("INTAKE") // INTAKE | DIAGNOSING | WAITING_PARTS | READY | COLLECTED | CANCELLED

  estimateCents Int @default(0)
  labourCents   Int @default(0)
  depositCents  Int @default(0)

  technicianId String?
  technician   User?     @relation("Technician", fields: [technicianId], references: [id])
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id])

  promisedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  parts TicketPart[]
  sale  Sale?

  trackToken String? @unique

  signatureData String?   @db.Text
  signedAt      DateTime?

  @@unique([storeId, number])
  @@index([storeId])
}

model TicketPart {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  name       String
  quantity   Int      @default(1)
  priceCents Int      @default(0)
}

/* ------------------------------ sales ------------------------------ */

model Sale {
  id     String @id @default(cuid())
  /// The shop's own sale number, assigned in code (max + 1 within the store).
  /// Null for a sale rung up on the Clover register: that sale already has an
  /// identity in cloverOrderId, and minting a second one would both duplicate
  /// it and push the shop's own numbering along for a sale it didn't ring up.
  number Int?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  ticketId   String?   @unique
  ticket     Ticket?   @relation(fields: [ticketId], references: [id])

  subtotalCents Int @default(0)
  taxCents      Int @default(0)
  totalCents    Int @default(0)

  status String @default("OPEN") // OPEN | PAID | REFUNDED | VOID

  source        String  @default("APP") // APP | CLOVER
  cloverOrderId String? @unique
  needsReview   Boolean @default(false)

  createdAt DateTime @default(now())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  items    SaleItem[]
  payments Payment[]
  units    ProductUnit[]
  invoice  Invoice?

  @@unique([storeId, number])
  @@index([storeId])
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  name           String // snapshot — survives later product edits
  quantity       Int    @default(1)
  unitPriceCents Int    @default(0)
  costCents      Int    @default(0) // snapshot, for margin reports
}

model Payment {
  id        String   @id @default(cuid())
  saleId    String?
  sale      Sale?    @relation(fields: [saleId], references: [id])
  layawayId String?
  layaway   Layaway? @relation(fields: [layawayId], references: [id])

  amountCents Int

  /// CASH | CREDIT_CARD | DEBIT_CARD | CHEQUE | ETRANSFER | OTHER.
  /// CARD survives on payments taken before credit and debit were told apart.
  method String

  /// How it was paid, in words, when the till knew more than the method:
  /// "Interac ····9303, contactless". Null for anything typed in by hand.
  details String?

  reference String? // Clover payment id
  createdAt   DateTime @default(now())
}

/* --------------------------- daily performance --------------------------- */

/// One takings figure as the shop logs it at the end of a day.
///
/// Kept apart from Sale on purpose: this is what the shop counted, entered by
/// hand, and it is allowed to disagree with what the tills recorded. Folding
/// the two together would make each unable to check the other.
model PerformanceEntry {
  id String @id @default(cuid())

  /// The trading day it belongs to, not the moment it was typed in.
  date DateTime @db.Date

  saleType    String // SERVICE | INVENTORY
  paymentType String // CASH | CREDIT_CARD | DEBIT_CARD | CHEQUE | ETRANSFER
  amountCents Int
  note        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, date])
}

/* ----------------------------- layaway ----------------------------- */

model Layaway {
  id     String @id @default(cuid())
  number Int // assigned in code (max + 1 within the store)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  totalCents Int    @default(0)
  paidCents  Int    @default(0)
  status     String @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED | EXPIRED

  expiresAt DateTime?
  notes     String? @db.Text
  createdAt DateTime  @default(now())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  items    LayawayItem[]
  payments Payment[]

  @@unique([storeId, number])
  @@index([storeId])
}

model LayawayItem {
  id             String   @id @default(cuid())
  layawayId      String
  layaway        Layaway  @relation(fields: [layawayId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  name           String
  quantity       Int      @default(1)
  unitPriceCents Int      @default(0)
}

/* ----------------------------- invoices ----------------------------- */

model Invoice {
  id     String @id @default(cuid())
  number Int // assigned in code (max + 1 within the store)
  saleId String @unique
  sale   Sale   @relation(fields: [saleId], references: [id])

  sentTo    String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, number])
  @@index([storeId])
}

/* --------------------------- vendor sourcing --------------------------- */
//
// What a vendor is *offering*, as opposed to what the shop owns. The two are
// deliberately separate trees:
//
//   Product / ProductUnit  — stock on the shelf, with a SKU, a cost and serials
//   CatalogProduct / VendorOffer — a thing a vendor sells, and what they want
//                                  for it today
//
// Folding them together would mean inventing a SKU and a stock record for every
// line of every price list, most of which the shop will never buy.

/// One real-world product, written the same way no matter which vendor is
/// describing it. Vendors write "iPad 8", "IPAD 8 WIFI", "Apple iPad 8th Gen";
/// all three land here once, and every vendor's price hangs off it.
///
/// `matchKey` is the deterministic signature of the significant attributes
/// (see sourcing/normalize.js). Two rows with the same key ARE the same
/// product; two rows with different keys are never merged automatically, which
/// is what keeps "iPad 8 WiFi 32GB" apart from "iPad 8 WiFi+Cellular 32GB".
model CatalogProduct {
  id String @id @default(cuid())

  brand       String?
  model       String?
  generation  String?
  productType String? // Phone | Tablet | Laptop | Watch | Accessory | Other

  /// How the product is shown everywhere in the UI.
  normalizedName String

  /// The significant attributes, joined. Unique within a store.
  matchKey String

  storage      String?
  ram          String?
  connectivity String? // WiFi | WiFi + Cellular | LTE | 5G
  carrier      String?
  condition    String? // New | Open box | Used | For parts
  grade        String? // A | B | C ...
  color        String?
  cpu          String?
  screenSize   String?

  /// Anything the parser recognised but has no column for.
  specifications Json?

  /// Last time the online retail lookup ran for this product. Null means never.
  onlineCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  offers       VendorOffer[]
  onlinePrices OnlinePrice[]

  @@unique([storeId, matchKey])
  @@index([storeId, brand])
  @@index([storeId, normalizedName])
}

/// The raw text a vendor sent, kept forever so any offer can be traced back to
/// the words it came from.
model VendorMessage {
  id String @id @default(cuid())

  rawMessage String @db.LongText
  status     String @default("IMPORTED") // PARSED | IMPORTED | DISCARDED

  /// What the person importing called this batch — "Digital Junction Aug 21",
  /// "morning list". How an import is found again later, so null falls back to
  /// the vendor and the date.
  name String?

  /// How many offers this message produced.
  itemCount Int @default(0)

  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  importedById String?
  importedBy   User?   @relation(fields: [importedById], references: [id])

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  offers VendorOffer[]

  @@index([storeId, receivedAt])
  @@index([vendorId])
}

/// What one vendor charges for one product at one quantity break.
///
/// A vendor can have several rows for the same product — 1-4 at $130, 5-9 at
/// $125, 10+ at $119.99. `minQuantity` is what identifies a tier, so re-sending
/// the same tier updates the price (and writes history) instead of piling up
/// duplicates.
model VendorOffer {
  id String @id @default(cuid())

  priceCents Int
  currency   String @default("CAD")

  minQuantity Int  @default(1)
  /// Null means "and up" — no ceiling.
  maxQuantity Int?

  /// How many the vendor said they had, when their list says so. Not the same
  /// thing as minQuantity at all: a "Live List" column of 4 means they hold
  /// four, not that you must take four. Null means they didn't say.
  availableQuantity Int?

  /// Condition and grade as this vendor stated them for this offer. They can
  /// be narrower than the product's own (a vendor quoting Grade B stock of a
  /// product recorded without a grade).
  condition String?
  grade     String?

  note String? @db.Text

  /// Cleared when a vendor stops listing it, rather than deleted, so history
  /// and the source message survive.
  active Boolean @default(true)

  /// Last time a vendor message repeated this offer.
  lastSeenAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)

  sourceMessageId String?
  sourceMessage   VendorMessage? @relation(fields: [sourceMessageId], references: [id])

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  history OfferPriceHistory[]

  @@unique([vendorId, catalogProductId, minQuantity])
  @@index([storeId, catalogProductId])
  @@index([storeId, vendorId])
}

/// What a product sells for online, as found by the lookup in sourcing/online.
///
/// Cached rather than fetched on every page view: these come from other
/// people's websites, and asking them for the same product all day would be
/// both slow and rude. Rows are replaced wholesale each time the lookup runs.
model OnlinePrice {
  id String @id @default(cuid())

  /// Which site it came from — see PROVIDERS in sourcing/online/providers.js.
  source      String
  sourceLabel String
  /// "retail" for national chains, "local" for the classified market.
  tier        String

  title      String  @db.Text
  url        String  @db.Text
  priceCents Int
  currency   String  @default("CAD")

  /// The town a local listing is in, when the source says.
  location String?
  inStock  Boolean?

  checkedAt DateTime @default(now())

  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, catalogProductId])
}

/// Every price change an offer has been through.
model OfferPriceHistory {
  id String @id @default(cuid())

  oldPriceCents Int
  newPriceCents Int
  changedAt     DateTime @default(now())

  vendorOfferId String
  vendorOffer   VendorOffer @relation(fields: [vendorOfferId], references: [id], onDelete: Cascade)

  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id])

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, changedAt])
  @@index([vendorOfferId])
}
