# MySQL — user:password@host:port/database
DATABASE_URL="mysql://root:yourpassword@localhost:3306/ccc_admin"

# Any long random string — this signs the login cookies.
SESSION_SECRET=change-this-to-something-random

# Used once by the seed script to create your first account.
OWNER_NAME=Amrullah
OWNER_EMAIL=owner@caceco.ca
OWNER_PASSWORD=changeme123

PORT=5000

# The IMEI checker (Tools → IMEI Checker) needs no configuration — it runs
# entirely off the bundled TAC database in server/data.

# Vendor pricing (Vendor pricing -> Import message) reads vendor price lists
# with a rules-based parser that needs no configuration at all.
#
# These two are optional, and only used for messages the rules cannot read: set
# them and a "Ask the assistant" tickbox appears on the import screen. Any
# OpenAI-compatible /chat/completions endpoint works. Model output is validated
# and still reviewed by a person before anything is saved.
# SOURCING_AI_URL="https://api.example.com/v1/chat/completions"
# SOURCING_AI_KEY=""
# SOURCING_AI_MODEL="gpt-4o-mini"
